# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública anon o publishable (nunca usar una service_role en el cliente móvil)
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Opcional. El backend no la utiliza para las solicitudes de usuarios; sus permisos
# omitirían RLS. Se conserva disponible solo para operaciones administrativas futuras.
SUPABASE_SERVICE_ROLE_KEY=

API_V1_PREFIX=/api/v1
PROJECT_NAME=TuristeaYa API
