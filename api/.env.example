# URL del proyecto Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública anon o publishable (nunca usar una service_role en el cliente móvil)
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Clave service_role del servidor (Settings > API > service_role). Úsala SOLO en
# el backend: bypasea RLS y el backend la necesita para lecturas de catálogo.
# Sin esta variable los GET anónimos de catálogo responden 503.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

API_V1_PREFIX=/api/v1
PROJECT_NAME=TuristeaYa API

# Modo prueba Insomnia: sin JWT se pueden listar TODAS las tablas (service role
# omite RLS). Al terminar las pruebas ponlo en False.
ALLOW_ANONYMOUS_LISTS=True
